# Copy to .env and fill in your values (all secrets live here, never in code)

# --- KNOT router (required) ---
KNOT_HOST=10.0.0.1            # KNOT address (e.g. WireGuard IP)
KNOT_USER=                      # KNOT REST API user
KNOT_PASS=                      # KNOT REST API password

# --- BLE sensors (required) ---
BM6_MAC=AA:BB:CC:DD:EE:01
MPPT_MAC=AA:BB:CC:DD:EE:02

# --- Dashboard (optional) ---
BOAT_NAME=Nautilus
URL_PREFIX_ALIAS=/nautilus

# --- Position history backend (optional) ---
CONTICINI_BASE=
INTERNAL_TOKEN=

# --- BL917 MPPT via cloud (optional) ---
BL917_ENABLED=0
BL917_MAC=
BL917_WS=ws://device.gz529.com/
BL917_TEMP_OFFSET=0

# --- Victron SmartSolar MPPT (optional) ---
VICTRON_MAC=
VICTRON_SERIAL=
VICTRON_ADV_KEY=
VICTRON_PUK=
