# Copy to .env and fill in your values (all secrets live here, never in code)

# --- Admin (required, used only on first boot to create the admin user) ---
ADMIN_USERNAME=federico
ADMIN_PASSWORD=            # set a strong password, min 10 chars

# --- App (required) ---
CONTICINI_DATA=/data
CONTICINI_PREFIX=/gestionale   # URL prefix behind the reverse proxy

# --- Boat name (optional, shown in title and login page) ---
BOAT_NAME=Nautilus

# --- Position history API (optional, shared with nautilus telemetry) ---
INTERNAL_TOKEN=           # empty = internal boat APIs disabled

# --- Cookies (optional) ---
SECURE_COOKIES=1          # set 0 only for local http testing
